{
  "name": "portal-teologia-reformada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "catalogo": "node scripts/gerar-catalogo.mjs && node scripts/gerar-curriculo-cliente.mjs",
    "regenerar:curriculo": "python3 scripts/extracao/extract.py && python3 scripts/extracao/ligaduras.py && python3 scripts/extracao/parse.py && python3 scripts/extracao/aplicar-correcoes-layout.py",
    "predev": "npm run catalogo",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run catalogo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prelint": "npm run catalogo",
    "lint": "tsc --noEmit",
    "auditar": "node scripts/auditar-links.mjs",
    "auditar:relatorio": "node scripts/auditar-links.mjs --relatorio",
    "auditar:metadados": "node scripts/auditar-metadados.mjs",
    "prevalidar": "npm run catalogo",
    "validar": "node scripts/validar-integridade.mjs && node scripts/validar-curriculo.mjs && node scripts/validar-plano-curricular.mjs && node scripts/validar-materiais-unidades.mjs && node scripts/validar-avaliacoes.mjs",
    "validar:curriculo": "node scripts/validar-curriculo.mjs",
    "validar:plano": "node scripts/validar-plano-curricular.mjs",
    "validar:materiais": "node scripts/validar-materiais-unidades.mjs",
    "validar:avaliacoes": "node scripts/validar-avaliacoes.mjs",
    "estado": "node scripts/estado.mjs",
    "progresso:curriculo": "node scripts/progresso-curricular.mjs",
    "proxima": "node scripts/progresso-curricular.mjs",
    "densidade:editorial": "node scripts/progresso-editorial.mjs",
    "priorizar": "node scripts/priorizar-conteudo.mjs",
    "conferir": "node scripts/estado.mjs --conferir"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
